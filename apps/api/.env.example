# Database
DATABASE_URL="postgresql://molyscan:molyscan_dev@localhost:5432/molyscan?schema=public"

# JWT
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# MinIO
MINIO_ENDPOINT="localhost"
MINIO_PORT=9000
MINIO_ACCESS_KEY="molyscan"
MINIO_SECRET_KEY="molyscan_dev"
MINIO_BUCKET="molyscan"
MINIO_USE_SSL=false

# Ollama (RAG / LLM)

# Sellbase PIM (server-side only — never expose these as EXPO_PUBLIC_* variables)
SELLBASE_API_URL=https://sellapi.sellbase-plateforme.com
SELLBASE_SERVER=base05
SELLBASE_BASE=c_molydal
# 0 imports the complete master catalogue. Set a publication ID only to restrict the scope.
SELLBASE_CATALOG_BASE_ID=0
# Additional folder element IDs to exclude (comma-separated). Molydal's
# ARCHIVAGE PRODUITS folder 25012891 is always excluded, including descendants.
SELLBASE_EXCLUDED_FOLDER_IDS=
SELLBASE_EMAIL=
SELLBASE_PASSWORD=
# Optional authenticated media override for other Sellbase environments.
# c_molydal uses the verified public CDN by default, without a media token:
# static.sellbase-plateforme.com/molydal/molydal/ + filename shard (a/ag/AGL_...pdf).
SELLBASE_MEDIA_BASE_URL=
MOLYDAL_PUBLIC_URL=https://www.molydal.com
SELLBASE_TOKEN_CACHE_PATH=/tmp/molyscan-sellbase-token.json

# Must be identical for document indexing and query embeddings.
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_EMBEDDING_DIMENSIONS=1536
QUERY_REFORMULATION_MODEL=gemini-3.1-flash-lite
CHAT_MODEL=gemini-3.1-flash-lite
VISION_MODEL=gemini-3.1-flash-lite
SCAN_SELECT_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="mistral"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# Whisper (Transcription)
WHISPER_MODEL_PATH="./models/whisper-small"

# Expo Push
EXPO_PUSH_ACCESS_TOKEN=""

# Resend (emails transactionnels)
RESEND_API_KEY=""
# Adresse expéditeur (doit appartenir à un domaine vérifié dans Resend)
RESEND_FROM_EMAIL="Molyscan <no-reply@votre-domaine.fr>"

# CRM Innovation (icyapi) — sync des notes vocales en communications
CRM_BASE_URL="https://molydal.innovationcrm.fr/backend/icyapi"
# Fuseau attendu pour les communications CRM (indépendant du fuseau du VPS).
CRM_TIME_ZONE="Europe/Paris"
# Paid CRM history editing: operator-controlled, disabled unless explicitly true.
# Changing this server setting and restarting the API does not require a mobile build.
CRM_HISTORY_EDITING_ENABLED=false
# Référentiels natifs : GET /api/AppStruct, offline.translations (type=choices).
# Familles comm_action / comm_liste_objectifs, code et libellé capt ; aucune configuration supplémentaire.
# Overrides facultatifs pour une autre installation : définir chemin, champ valeur et champ libellé ensemble.
# Chemins GET relatifs à CRM_BASE_URL ; réponses tableau / {records:[]} / {data:[]}.
CRM_ACTION_OPTIONS_PATH=""
CRM_ACTION_VALUE_FIELD=""
CRM_ACTION_LABEL_FIELD=""
CRM_OBJECTIVE_OPTIONS_PATH=""
CRM_OBJECTIVE_VALUE_FIELD=""
CRM_OBJECTIVE_LABEL_FIELD=""
# Les objectifs sont envoyés dans comm_liste_objectifs (tableau de chaînes, casse exacte).
# Clé de chiffrement (AES-256-GCM) des identifiants CRM stockés par commercial
CRM_ENCRYPTION_KEY="change-me-in-production"

# Console d'administration web (plateforme Vite/React)
# URL utilisée dans l'email admin pour pointer vers la page de validation
ADMIN_WEB_URL="http://localhost:5173"

# App
PORT=3000
NODE_ENV=development
API_PREFIX=api
